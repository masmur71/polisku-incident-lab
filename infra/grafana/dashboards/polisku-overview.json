{
  "annotations": {
    "list": []
  },
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 1,
  "id": null,
  "links": [],
  "liveNow": false,
  "panels": [
    {
      "id": 1,
      "title": "Total Request Rate",
      "type": "stat",
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 0,
        "y": 1
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "color": {
            "mode": "palette-classic"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 500
              }
            ]
          }
        }
      },
      "targets": [
        {
          "expr": "sum(rate(polisku_http_requests_total[1m])) or vector(0)",
          "legendFormat": "RPS",
          "refId": "A"
        }
      ]
    },
    {
      "id": 2,
      "title": "HTTP 5xx Error Rate",
      "type": "stat",
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 6,
        "y": 1
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 1
              },
              {
                "color": "red",
                "value": 5
              }
            ]
          }
        }
      },
      "targets": [
        {
          "expr": "((sum(rate(polisku_http_requests_total{status_code=~\"5..\"}[1m])) or vector(0)) / (sum(rate(polisku_http_requests_total[1m])) > 0) * 100) or vector(0)",
          "legendFormat": "Error Rate %",
          "refId": "A"
        }
      ]
    },
    {
      "id": 3,
      "title": "DB Pool Waiting Requests",
      "type": "stat",
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 12,
        "y": 1
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 1
              },
              {
                "color": "red",
                "value": 3
              }
            ]
          }
        }
      },
      "targets": [
        {
          "expr": "polisku_pg_pool_waiting_connections",
          "legendFormat": "Waiting Connections",
          "refId": "A"
        }
      ]
    },
    {
      "id": 4,
      "title": "Node.js Heap Used",
      "type": "stat",
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 18,
        "y": 1
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "bytes",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 150000000
              },
              {
                "color": "red",
                "value": 250000000
              }
            ]
          }
        }
      },
      "targets": [
        {
          "expr": "polisku_nodejs_heap_size_used_bytes",
          "legendFormat": "Heap Used",
          "refId": "A"
        }
      ]
    },
    {
      "id": 5,
      "title": "HTTP Request Rate by Status Code",
      "type": "timeseries",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 6
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "smooth",
            "fillOpacity": 15
          }
        }
      },
      "targets": [
        {
          "expr": "sum(rate(polisku_http_requests_total[30s])) by (status_code)",
          "legendFormat": "Status {{status_code}}",
          "refId": "A"
        }
      ]
    },
    {
      "id": 6,
      "title": "HTTP Latency (p50, p95, p99)",
      "type": "timeseries",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 6
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "smooth",
            "fillOpacity": 10
          }
        }
      },
      "targets": [
        {
          "expr": "histogram_quantile(0.50, sum(rate(polisku_http_request_duration_seconds_bucket{route!~\"/simulations/.*|unmatched\"}[1m])) by (le, route))",
          "legendFormat": "p50 (median) {{route}}",
          "refId": "A"
        },
        {
          "expr": "histogram_quantile(0.95, sum(rate(polisku_http_request_duration_seconds_bucket{route!~\"/simulations/.*|unmatched\"}[1m])) by (le, route))",
          "legendFormat": "p95 {{route}}",
          "refId": "B"
        },
        {
          "expr": "histogram_quantile(0.99, sum(rate(polisku_http_request_duration_seconds_bucket{route!~\"/simulations/.*|unmatched\"}[1m])) by (le, route))",
          "legendFormat": "p99 {{route}}",
          "refId": "C"
        }
      ]
    },
    {
      "id": 7,
      "title": "PostgreSQL Connection Pool Status",
      "type": "timeseries",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 15
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "linear",
            "fillOpacity": 15
          }
        }
      },
      "targets": [
        {
          "expr": "polisku_pg_pool_total_connections",
          "legendFormat": "Total Connections",
          "refId": "A"
        },
        {
          "expr": "polisku_pg_pool_idle_connections",
          "legendFormat": "Idle Connections",
          "refId": "B"
        },
        {
          "expr": "polisku_pg_pool_waiting_connections",
          "legendFormat": "Waiting Clients (Queued)",
          "refId": "C"
        }
      ]
    },
    {
      "id": 8,
      "title": "Node.js heap used vs V8 limit",
      "type": "timeseries",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 15
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "bytes",
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "smooth",
            "fillOpacity": 20
          }
        }
      },
      "targets": [
        {
          "expr": "polisku_nodejs_heap_size_used_bytes",
          "legendFormat": "Heap Used",
          "refId": "A"
        },
        {
          "expr": "polisku_heap_limit_bytes",
          "legendFormat": "V8 heap limit",
          "refId": "B"
        }
      ]
    },
    {
      "id": 9,
      "title": "Event Loop Lag",
      "type": "timeseries",
      "gridPos": {
        "h": 6,
        "w": 24,
        "x": 0,
        "y": 23
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "smooth",
            "fillOpacity": 15
          }
        }
      },
      "targets": [
        {
          "expr": "polisku_nodejs_eventloop_lag_seconds",
          "legendFormat": "Event Loop Lag",
          "refId": "A"
        }
      ]
    },
    {
      "id": 20,
      "type": "timeseries",
      "title": "In-flight HTTP requests",
      "gridPos": {
        "h": 7,
        "w": 12,
        "x": 0,
        "y": 29
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "polisku_http_in_flight_requests",
          "legendFormat": "In-flight HTTP requests"
        }
      ]
    },
    {
      "id": 21,
      "type": "timeseries",
      "title": "Dedicated incident disk used (%)",
      "gridPos": {
        "h": 7,
        "w": 12,
        "x": 12,
        "y": 29
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percent"
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "100 * (1 - polisku_incident_disk_avail_bytes / polisku_incident_disk_size_bytes)",
          "legendFormat": "Dedicated incident disk used (%)"
        }
      ]
    },
    {
      "id": 22,
      "type": "timeseries",
      "title": "Process RSS",
      "gridPos": {
        "h": 7,
        "w": 12,
        "x": 0,
        "y": 36
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "bytes"
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "polisku_process_resident_memory_bytes",
          "legendFormat": "Process RSS"
        }
      ]
    },
    {
      "id": 23,
      "type": "timeseries",
      "title": "Process CPU cores",
      "gridPos": {
        "h": 7,
        "w": 12,
        "x": 12,
        "y": 36
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "rate(polisku_process_cpu_seconds_total[1m])",
          "legendFormat": "Process CPU cores"
        }
      ]
    },
    {
      "id": 24,
      "type": "timeseries",
      "title": "Completed partner calls by outcome",
      "gridPos": {
        "h": 7,
        "w": 12,
        "x": 0,
        "y": 43
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (outcome) (polisku_downstream_requests_total)",
          "legendFormat": "{{outcome}}"
        }
      ]
    },
    {
      "id": 25,
      "type": "timeseries",
      "title": "Client disconnects",
      "gridPos": {
        "h": 7,
        "w": 12,
        "x": 12,
        "y": 43
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps"
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "rate(polisku_http_aborted_requests_total[1m])",
          "legendFormat": "Client disconnects"
        }
      ]
    }
  ],
  "refresh": "5s",
  "schemaVersion": 38,
  "style": "dark",
  "tags": [
